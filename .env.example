# ---------- Local development (npm run dev) ----------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kwings_accounts
DB_USERNAME=postgres
DB_PASSWORD=change-me
# Tests TRUNCATE every table: must name a separate database containing "test".
TEST_DB_DATABASE=kwings_accounts_test
# Optional: run migrations as a different (owner) role than the app.
# MIGRATION_DB_USERNAME=
# MIGRATION_DB_PASSWORD=

JWT_SECRET=generate-with-openssl-rand-hex-32
COOKIE_SECURE=false
API_PORT=4000

ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@kwingsmedia.com
ADMIN_PASSWORD=change-me-strong-password

# ---------- Production (/opt/kwings-accounts/.env on the VPS) ----------
# POSTGRES_DB=kwings_accounts
# POSTGRES_USER=kwings_owner            # owns schema, runs migrations
# POSTGRES_PASSWORD=<openssl rand -hex 24>
# APP_DB_USERNAME=kwings_app            # least-privilege runtime role
# APP_DB_PASSWORD=<openssl rand -hex 24>
# JWT_SECRET=<openssl rand -hex 32>
# ADMIN_NAME=Administrator
# ADMIN_EMAIL=admin@kwingsmedia.com
# ADMIN_PASSWORD=<strong password; change it in Settings after first login>
# API_HOST_PORT=4020
# WEB_HOST_PORT=3020
